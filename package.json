{
  "name": "@graffhyrum/crap4ts",
  "version": "2.1.1",
  "packageManager": "bun@1.4.2",
  "description": "CRAP score calculator for TypeScript/JavaScript codebases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graffhyrum/crap4ts.git"
  },
  "bugs": {
    "url": "https://github.com/graffhyrum/crap4ts/issues"
  },
  "homepage": "https://github.com/graffhyrum/crap4ts#readme",
  "license": "UNLICENSED",
  "bin": {
    "crap4ts": "src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "lint": "bunx oxlint --quiet src/",
    "fmt": "bunx oxfmt src/",
    "fmt:check": "bunx oxfmt --check src/",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "score": "bun src/index.ts -c coverage/lcov.info -f lcov --exclude \"**/*.test.ts\" --quiet",
    "vet": "bun scripts/vet.ts",
    "gate": "bun test --coverage --only-failures && bun run score",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "rule-validator": "rule-validator",
    "stepdown-rule": "stepdown-rule \"**/*.ts\""
  },
  "dependencies": {
    "arktype": "^2.2.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@graff/rule-validator": "github:graffhyrum/rule-validator#v1.1.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "0.36.0",
    "oxlint": "1.52.0",
    "stepdown-rule": "github:graffhyrum/stepdown-rule#v0.4.3"
  }
}
