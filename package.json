{
  "name": "crap4ts",
  "version": "1.0.0",
  "description": "CRAP score calculator for TypeScript/JavaScript codebases",
  "bin": {
    "crap4ts": "src/index.ts"
  },
  "scripts": {
    "lint": "bunx oxlint src/",
    "fmt": "bunx oxfmt src/",
    "fmt:check": "bunx oxfmt --check src/",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "vet": "bun run lint && bun run fmt && bun run check && bun run test"
  },
  "dependencies": {
    "arktype": "^2",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "oxfmt": "0.36.0",
    "oxlint": "1.52.0"
  },
  "private": true
}
