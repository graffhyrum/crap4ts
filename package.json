{
  "name": "@graffhyrum/crap4ts",
  "version": "2.0.0",
  "packageManager": "bun@1.4.2",
  "description": "CRAP score calculator for TypeScript/JavaScript codebases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graffhyrum/crap4ts.git"
  },
  "bugs": {
    "url": "https://github.com/graffhyrum/crap4ts/issues"
  },
  "homepage": "https://github.com/graffhyrum/crap4ts#readme",
  "license": "UNLICENSED",
  "bin": {
    "crap4ts": "src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "lint": "bunx oxlint src/",
    "fmt": "bunx oxfmt src/",
    "fmt:check": "bunx oxfmt --check src/",
    "lint:boundaries": "depcruise src/packages",
    "check": "bunx tsc --noEmit && bun run lint:boundaries",
    "test": "bun test",
    "score": "bun src/index.ts -c coverage/lcov.info -f lcov --exclude \"**/*.test.ts\"",
    "vet": "bun run lint && bun run fmt && bun run check && bun run gate",
    "gate": "rule-validator && stepdown-rule fix \"**/*.ts\" && bun test --coverage && bun run score",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "arktype": "^2.2.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^18.4.0",
    "oxfmt": "0.36.0",
    "oxlint": "1.52.0"
  }
}
